# Copiar a deploy/.env en el VPS. NO commitear.

# --- Imagenes -------------------------------------------------------------
# Repositorio de GHCR sin el sufijo -api / -web.
GITHUB_REPOSITORY=pel-matiasvaldivia/trading
# 'latest' sigue a main. En produccion conviene fijar un tag inmutable
# (sha-<commit> o v1.2.3) para que un redeploy no traiga cambios sorpresa.
IMAGE_TAG=latest

# --- Red ------------------------------------------------------------------
# Nombre de la red Docker que ya usa Nginx Proxy Manager.
#   docker network ls
PROXY_NETWORK=npm_default

# --- Puertos publicados en el host ---------------------------------------
# Puerto externo del frontend (sirve tambien /api via nginx).
WEB_PORT=8080
# Interfaz donde se publica.
#   0.0.0.0   -> accesible desde internet, SIN el TLS de NPM. El trafico va
#                en claro y el DASHBOARD_TOKEN viaja en un header sin cifrar.
#                Usalo solo si vas a poner un firewall delante, o para probar.
#   127.0.0.1 -> solo desde el propio VPS. Es lo correcto cuando NPM hace de
#                frente: NPM llega al contenedor por la red Docker, no por
#                este puerto.
WEB_BIND=0.0.0.0

# La API tambien, para diagnosticar con curl desde el VPS. Dejar en
# 127.0.0.1 salvo que tengas un motivo concreto: el frontend ya la sirve
# en /api, y exponerla aparte solo agrega superficie.
API_PORT=8000
API_BIND=127.0.0.1

# --- Dashboard ------------------------------------------------------------
# Obligatorio. Generar con: openssl rand -hex 32
DASHBOARD_TOKEN=

# --- Bot ------------------------------------------------------------------
TRADING_BOOK=usd_ars
STARTING_CASH=33.27
COLLECT_INTERVAL=60

# --- Bitso ----------------------------------------------------------------
# Opcionales: los endpoints de mercado son publicos. Si se cargan, deben ser
# de una API key con permisos de SOLO LECTURA.
#   Lectura: si.  Trading: no (todavia).  Retiros: nunca.
BITSO_API_KEY=
BITSO_API_SECRET=
