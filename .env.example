# Copiar a .env SOLO para desarrollo local, o mejor: cargar estas variables
# como secretos del entorno de ejecucion. .env esta en .gitignore.
#
# La API key de Bitso debe crearse con permisos de SOLO LECTURA.
#   - Lectura (balance, ordenes, historial): SI
#   - Trading: no, hasta que la Fase 1 (papel) de expectancy positiva
#   - Retiros / withdrawals: NUNCA, en ninguna fase
#
# Si Bitso ofrece whitelist de IP, usarla. Rotar la key ante cualquier duda.

BITSO_API_KEY=
BITSO_API_SECRET=

# Opcionales
TRADING_BOOK=usd_ars
TRADING_DB_PATH=data/trading.db
