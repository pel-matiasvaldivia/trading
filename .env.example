# Copiar a .env y completar.  NO se commitea: .env esta en .gitignore porque
# lleva el token del dashboard y las credenciales de Bitso.
#
#   cp .env.example .env && chmod 600 .env
#
# Un solo archivo para las dos formas de correr esto:
#   - el bot local        ->  python -m tradingbot ...
#   - el stack en Docker  ->  docker compose up -d
# Cada seccion aclara quien la usa.


# =========================================================================
# Bitso  ·  usado por los dos
# =========================================================================
# Opcionales: los endpoints de mercado que usa el collector son publicos.
# Si se cargan, deben ser de una API key con permisos de SOLO LECTURA.
#   Lectura: si.   Trading: no (todavia).   Retiros: nunca.
BITSO_API_KEY=
BITSO_API_SECRET=


# =========================================================================
# Bot  ·  usado por los dos
# =========================================================================
TRADING_BOOK=usdt_ars
STARTING_CASH=33.27
# Segundos entre ciclos del collector.
COLLECT_INTERVAL=60


# =========================================================================
# Solo bot local
# =========================================================================
# En Docker esta ruta la fija el compose (/data/trading.db, sobre el volumen);
# este valor solo aplica cuando corres el bot fuera de contenedores.
TRADING_DB_PATH=data/trading.db


# =========================================================================
# Fase 1  ·  paper trading
# =========================================================================
# El collector corre el motor de papel despues de cada ciclo de recoleccion.
# Poner 0 para solo recolectar datos sin operar en papel.
PAPER_ENABLED=1

# Timeframe de las velas sobre las que opera. Con costos de ~1.6% por
# operacion, los timeframes cortos no cierran: la comision se come cualquier
# movimiento pequeno. 1h o mas.
PAPER_TF=1h

# Medias rapida y lenta de la estrategia baseline. El warmup es slow+1 velas:
# hasta llegar ahi el motor no emite senales.
PAPER_FAST=10
PAPER_SLOW=30

# IMPORTANTE: la API lee estas tres mismas variables. Si difieren entre el
# collector y la API, el dashboard evaluaria una corrida distinta de la que
# realmente esta operando.


# =========================================================================
# Solo stack Docker  ·  imagenes
# =========================================================================
# Repositorio de GHCR, sin el sufijo -api / -web.
GITHUB_REPOSITORY=pel-matiasvaldivia/trading
# 'latest' sigue a main. En produccion conviene fijar un tag inmutable
# (sha-<commit> o v1.2.3) para que un redeploy no traiga cambios sorpresa.
IMAGE_TAG=latest


# =========================================================================
# Solo stack Docker  ·  red
# =========================================================================
# Nombre de la red Docker que ya usa Nginx Proxy Manager. Tiene que existir
# de antes:  docker network ls
PROXY_NETWORK=npm_default


# =========================================================================
# Solo stack Docker  ·  puertos publicados en el host
# =========================================================================
# Puerto externo del frontend (sirve tambien /api via nginx).
WEB_PORT=8080
# Interfaz donde se publica.
#   0.0.0.0   -> accesible desde internet, SIN el TLS de NPM. El trafico va
#                en claro y el DASHBOARD_TOKEN viaja en un header sin cifrar.
#                Usalo solo con un firewall delante, o para probar.
#   127.0.0.1 -> solo desde el propio VPS. Es lo correcto cuando NPM hace de
#                frente: NPM llega al contenedor por la red Docker, no por
#                este puerto.
WEB_BIND=0.0.0.0

# La API tambien, para diagnosticar con curl desde el VPS. Dejar en
# 127.0.0.1 salvo que tengas un motivo concreto: el frontend ya la sirve
# en /api, y exponerla aparte solo agrega superficie.
API_PORT=8000
API_BIND=127.0.0.1


# =========================================================================
# Solo stack Docker  ·  dashboard
# =========================================================================
# Obligatorio: sin esto el compose se niega a levantar. Generar con:
#   openssl rand -hex 32
DASHBOARD_TOKEN=
